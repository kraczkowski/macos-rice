# Sunset Ember — btop theme
# Dark teal base, oxidized-iron + ember reds, warm sunset gradients.
# The colours are named in theme.ini.

# Main background. Empty = use terminal background (Ghostty is transparent+blur).
theme[main_bg]=""

# Main text color
theme[main_fg]="#{{text}}"

# Title color for boxes
theme[title]="#{{text}}"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#{{ember}}"

# Background color of selected item in processes box
theme[selected_bg]="#{{wine}}"

# Foreground color of selected item in processes box
theme[selected_fg]="#{{text}}"

# Color of inactive/disabled text
theme[inactive_fg]="#{{slate}}"

# Color of text appearing on top of graphs (uptime, net scaling)
theme[graph_text]="#{{sand}}"

# Background color of the percentage meters
theme[meter_bg]="#{{surface}}"

# Misc colors for processes box (mini graphs, details text)
theme[proc_misc]="#{{sand}}"

# Box outlines
theme[cpu_box]="#{{ember}}"
theme[mem_box]="#{{oxide}}"
theme[net_box]="#{{wine}}"
theme[proc_box]="#{{oxide}}"

# Box divider line and small boxes line color
theme[div_line]="#{{line}}"

# Temperature graph: wine -> ember -> gold
theme[temp_start]="#{{wine}}"
theme[temp_mid]="#{{ember}}"
theme[temp_end]="#{{gold}}"

# CPU graph: mahogany -> ember -> sunset orange
theme[cpu_start]="#{{mahogany}}"
theme[cpu_mid]="#{{ember}}"
theme[cpu_end]="#{{orange}}"

# Mem/Disk free meter: muted warm
theme[free_start]="#{{mahogany}}"
theme[free_mid]="#{{oxide}}"
theme[free_end]="#{{sand}}"

# Mem/Disk cached meter: cool teal accent (contrast against the warm)
theme[cached_start]="#{{surface}}"
theme[cached_mid]="#{{pine}}"
theme[cached_end]="#{{mist}}"

# Mem/Disk available meter: warm gold
theme[available_start]="#{{wine}}"
theme[available_mid]="#{{copper}}"
theme[available_end]="#{{gold}}"

# Mem/Disk used meter: ember
theme[used_start]="#{{mahogany}}"
theme[used_mid]="#{{ember}}"
theme[used_end]="#{{orange}}"

# Download graph: ember warm
theme[download_start]="#{{wine}}"
theme[download_mid]="#{{ember}}"
theme[download_end]="#{{gold}}"

# Upload graph: oxidized iron
theme[upload_start]="#{{mahogany}}"
theme[upload_mid]="#{{oxide}}"
theme[upload_end]="#{{orange}}"

# Process box gradient (threads / mem / cpu usage)
theme[process_start]="#{{wine}}"
theme[process_mid]="#{{ember}}"
theme[process_end]="#{{gold}}"
