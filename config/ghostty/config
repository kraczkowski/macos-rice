# Ghostty — Sunset Ember
# Docs: https://ghostty.org/docs/config

font-family = "{{font}}"
font-size = 12

background = {{base}}
foreground = {{text}}
cursor-color = {{ember}}
cursor-style = bar
cursor-style-blink = false
selection-background = {{mahogany}}
selection-foreground = {{text}}

# normal
palette = 0=#{{black}}
palette = 1=#{{ember}}
palette = 2=#{{moss}}
palette = 3=#{{amber}}
palette = 4=#{{ocean}}
palette = 5=#{{berry}}
palette = 6=#{{teal}}
palette = 7=#{{text}}
# bright
palette = 8=#{{plum}}
palette = 9=#{{flame}}
palette = 10=#{{olive}}
palette = 11=#{{gold}}
palette = 12=#{{steel}}
palette = 13=#{{rose}}
palette = 14=#{{sky}}
palette = 15=#{{cream}}

background-opacity = {{opacity}}
background-blur-radius = {{blur}}
window-padding-x = 12
window-padding-y = 12
window-decoration = true
macos-titlebar-style = transparent
macos-titlebar-proxy-icon = hidden

# Global dropdown terminal — summon Ghostty over any app with ctrl+`
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.12
