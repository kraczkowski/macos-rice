{
  "name": "Sunset Ember",
  "type": "dark",
  "colors": {
    "focusBorder": "#{{ember}}",
    "foreground": "#{{text}}",
    "descriptionForeground": "#{{sand}}",
    "disabledForeground": "#{{slate}}",
    "errorForeground": "#{{flame}}",
    "selection.background": "#{{mahogany}}",
    "textLink.foreground": "#{{sky}}",
    "textLink.activeForeground": "#{{sky}}",

    "editor.background": "#{{base}}",
    "editor.foreground": "#{{text}}",
    "editor.lineHighlightBackground": "#{{surface}}",
    "editor.selectionBackground": "#{{mahogany}}",
    "editor.findMatchBackground": "#{{flame}}80",
    "editor.findMatchHighlightBackground": "#{{amber}}40",
    "editorCursor.foreground": "#{{ember}}",
    "editorLineNumber.foreground": "#{{faint}}",
    "editorLineNumber.activeForeground": "#{{flame}}",
    "editorIndentGuide.background1": "#{{surface}}",
    "editorIndentGuide.activeBackground1": "#{{line}}",
    "editorBracketMatch.background": "#{{surface}}",
    "editorBracketMatch.border": "#{{gold}}",
    "editorWidget.background": "#{{surface}}",
    "editorWidget.border": "#{{line}}",
    "editorSuggestWidget.selectedBackground": "#{{ember}}",
    "editorError.foreground": "#{{flame}}",
    "editorWarning.foreground": "#{{gold}}",
    "editorInfo.foreground": "#{{sky}}",
    "editorGutter.addedBackground": "#{{olive}}",
    "editorGutter.modifiedBackground": "#{{amber}}",
    "editorGutter.deletedBackground": "#{{ember}}",

    "titleBar.activeBackground": "#{{base}}",
    "titleBar.activeForeground": "#{{text}}",
    "titleBar.inactiveBackground": "#{{base}}",
    "titleBar.inactiveForeground": "#{{muted}}",
    "activityBar.background": "#{{base}}",
    "activityBar.foreground": "#{{linen}}",
    "activityBar.inactiveForeground": "#{{muted}}",
    "activityBar.activeBorder": "#{{ember}}",
    "activityBarBadge.background": "#{{ember}}",
    "activityBarBadge.foreground": "#{{cream}}",
    "sideBar.background": "#{{base}}",
    "sideBar.foreground": "#{{sand}}",
    "sideBar.border": "#{{surface}}",
    "sideBarTitle.foreground": "#{{text}}",
    "sideBarSectionHeader.background": "#{{base}}",
    "list.activeSelectionBackground": "#{{mahogany}}",
    "list.activeSelectionForeground": "#{{cream}}",
    "list.inactiveSelectionBackground": "#{{surface}}",
    "list.hoverBackground": "#{{surface}}",
    "list.highlightForeground": "#{{flame}}",

    "editorGroupHeader.tabsBackground": "#{{base}}",
    "editorGroup.border": "#{{surface}}",
    "tab.activeBackground": "#{{surface}}",
    "tab.activeForeground": "#{{cream}}",
    "tab.activeBorderTop": "#{{ember}}",
    "tab.inactiveBackground": "#{{base}}",
    "tab.inactiveForeground": "#{{muted}}",
    "tab.border": "#{{base}}",

    "statusBar.background": "#{{surface}}",
    "statusBar.foreground": "#{{sand}}",
    "statusBar.noFolderBackground": "#{{surface}}",
    "statusBar.debuggingBackground": "#{{ember}}",
    "statusBarItem.remoteBackground": "#{{ember}}",
    "statusBarItem.remoteForeground": "#{{cream}}",

    "panel.background": "#{{base}}",
    "panel.border": "#{{surface}}",
    "panelTitle.activeBorder": "#{{ember}}",
    "panelTitle.activeForeground": "#{{text}}",
    "panelTitle.inactiveForeground": "#{{muted}}",

    "input.background": "#{{surface}}",
    "input.foreground": "#{{text}}",
    "input.placeholderForeground": "#{{muted}}",
    "dropdown.background": "#{{surface}}",
    "button.background": "#{{ember}}",
    "button.foreground": "#{{cream}}",
    "button.hoverBackground": "#{{flame}}",
    "badge.background": "#{{ember}}",
    "badge.foreground": "#{{cream}}",
    "progressBar.background": "#{{ember}}",
    "scrollbarSlider.background": "#{{line}}80",
    "scrollbarSlider.hoverBackground": "#{{line}}",
    "quickInput.background": "#{{surface}}",
    "menu.background": "#{{surface}}",
    "menu.selectionBackground": "#{{ember}}",
    "notifications.background": "#{{surface}}",
    "gitDecoration.modifiedResourceForeground": "#{{amber}}",
    "gitDecoration.untrackedResourceForeground": "#{{olive}}",
    "gitDecoration.deletedResourceForeground": "#{{ember}}",

    "terminal.background": "#{{base}}",
    "terminal.foreground": "#{{text}}",
    "terminalCursor.foreground": "#{{ember}}",
    "terminal.ansiBlack": "#{{black}}",
    "terminal.ansiRed": "#{{ember}}",
    "terminal.ansiGreen": "#{{moss}}",
    "terminal.ansiYellow": "#{{amber}}",
    "terminal.ansiBlue": "#{{ocean}}",
    "terminal.ansiMagenta": "#{{berry}}",
    "terminal.ansiCyan": "#{{teal}}",
    "terminal.ansiWhite": "#{{text}}",
    "terminal.ansiBrightBlack": "#{{plum}}",
    "terminal.ansiBrightRed": "#{{flame}}",
    "terminal.ansiBrightGreen": "#{{olive}}",
    "terminal.ansiBrightYellow": "#{{gold}}",
    "terminal.ansiBrightBlue": "#{{steel}}",
    "terminal.ansiBrightMagenta": "#{{rose}}",
    "terminal.ansiBrightCyan": "#{{sky}}",
    "terminal.ansiBrightWhite": "#{{cream}}"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#{{muted}}", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#{{gold}}" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#{{amber}}" } },
    { "scope": ["constant.language", "constant.other", "meta.preprocessor", "entity.name.tag"], "settings": { "foreground": "#{{rose}}" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier"], "settings": { "foreground": "#{{flame}}" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#{{sand}}" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#{{sky}}" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#{{teal}}" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#{{text}}" } },
    { "scope": ["constant.character.escape", "entity.other.attribute-name"], "settings": { "foreground": "#{{olive}}" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#{{flame}}", "fontStyle": "bold" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#{{sky}}" } },
    { "scope": ["invalid"], "settings": { "foreground": "#{{text}}", "background": "#{{ember}}" } }
  ]
}
