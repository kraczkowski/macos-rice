#!/usr/bin/env python3
"""An ember black hole in the terminal, for the showpiece. It spins as fast as the machine is busy.

    hole        spin until ctrl-c
    hole check  draw a small one with no screen, and stop if it is not a black hole

The hole is a ring of glowing dust seen from a little above, so it is drawn as a flat ellipse,
with a thin halo around the dark middle: the far side of the ring, its light bent over the top.
Every dot of dust has a heat, from 0 (none) to 1 (the most). Two spiral waves run round the dust
at different speeds, and where both are high it is the hottest. The side that turns towards you
is the hotter one.

A character cell is eight dots, two across and four down, drawn with the braille characters
(⠁ to ⣿). Nothing is drawn but the dots: no cell is ever filled, so the glass of the window shows
between them everywhere. Each dot has a grain, set once, and is lit only while it is hotter than
that, so dust half as hot has half the dots, and the dots come and go as the
waves pass.
"""

import math
import os
import random
import shutil
import sys
import time

# The colours of the dust as theme.ini names them, from the coolest to the hottest.
GRADIENT = ("{{ember|rgb}}", "{{orange|rgb}}", "{{gold|rgb}}", "{{cream|rgb}}")
SHADES = 48  # how many steps of colour lie between the coolest and the hottest
FPS = 20


def shades():
    """SHADES colours along GRADIENT, each as the "r;g;b" a terminal wants."""
    stops = [[int(part) for part in colour.split(";")] for colour in GRADIENT]
    made = []
    for shade in range(SHADES):
        place = shade / (SHADES - 1) * (len(stops) - 1)
        low = min(int(place), len(stops) - 2)
        made.append(";".join(str(round(a + (b - a) * (place - low))) for a, b in zip(stops[low], stops[low + 1])))
    return made


SHADE = shades()


TILT = 0.3  # how flat the ring looks: 1 is seen from straight above, 0 from the side


def speed():
    """How fast the dust goes round, in radians a second: the load of the last minute, the most when every core is busy."""
    return 0.5 + 2.5 * min(os.getloadavg()[0] / os.cpu_count(), 1)


# The dots of a braille cell, as (across, down, its bit in the character).
DOTS = ((0, 0, 1), (0, 1, 2), (0, 2, 4), (0, 3, 64), (1, 0, 8), (1, 1, 16), (1, 2, 32), (1, 3, 128))


def dust(wide, lines):
    """The dust on a screen of that many cells: for every line, its cells that can light up, from the left, each as
    (column, its dots), and a dot as (its bit, the most heat it gets, where it is on the first wave, on the second, its grain)."""
    middle_x, middle_y = (2 * wide - 1) / 2, (4 * lines - 1) / 2
    edge = min(0.38 * 2 * wide, 1.1 * 4 * lines)  # the outside of the ring, as far across as fits
    hole = 0.2 * edge                             # the dark middle
    inside = 1.3 * hole                           # where the ring starts
    grain = random.Random(0)                      # the same dust every time
    rows = []
    for line in range(lines):
        cells = []
        for column in range(wide):
            dots = []
            for across, down, bit in DOTS:
                dx, dy = 2 * column + across - middle_x, 4 * line + down - middle_y
                far = math.hypot(dx, dy)          # from the middle of the screen
                out = math.hypot(dx, dy / TILT)   # from the middle along the tilted ring
                most = 0.0
                if hole <= far < 1.5 * hole:      # the halo: a round ring, hottest at the edge of the dark
                    most, turn, along = 1 - (far - hole) / (0.5 * hole), math.atan2(dy, dx), far
                # The ring itself. Its near half (below the middle) passes in front of the dark and of
                # the halo; its far half is hidden behind the dark.
                if inside <= out < edge and (dy > 0 or far >= hole):
                    ring = (1 - (out - inside) / (edge - inside)) ** 0.8
                    if dy > 0 or ring > most:
                        most, turn, along = ring, math.atan2(dy / TILT, dx), out
                if most > 0.1:
                    most *= 0.9 - 0.1 * math.cos(turn)  # the left side turns towards you
                    # Spirals: further out is further behind, so the arms trail.
                    dots.append((bit, most, 2 * turn + 3 * math.log(along), 5 * turn + 4 * math.log(along), grain.random()))
            if dots:
                cells.append((column, dots))
        rows.append(cells)
    return rows


def glow(cells, spun):
    """The cells of one line when the dust has gone round by spun radians, each as (column, the bits of its lit dots, the heat of the hottest)."""
    sin = math.sin
    for column, dots in cells:
        bits, top = 0, 0.0
        for bit, most, one, two, grain in dots:
            heat = most * (0.75 + 0.25 * sin(one - spun) * sin(two - 1.7 * spun))
            if heat > grain:
                bits |= bit
                if heat > top:
                    top = heat
        yield column, bits, top


def picture(rows, spun):
    """The dust, gone round by spun radians, as the text that draws it. Only the cells that can light up are written."""
    out = []
    for line, cells in enumerate(rows):
        if not cells:
            continue
        at = cells[0][0]
        out.append(f"\x1b[{line + 1};{at + 1}H")
        shade = None
        for column, bits, top in glow(cells, spun):
            if not bits:
                continue  # left to the spaces below
            if column > at:
                out.append(" " * (column - at))  # over the dots that were lit there a frame ago
            new = int(top * (SHADES - 1))
            if new != shade:  # colours are said only where they change
                out.append(f"\x1b[38;2;{SHADE[new]}m")
                shade = new
            out.append(chr(0x2800 + bits))
            at = column + 1
        out.append(" " * (cells[-1][0] + 1 - at) + "\x1b[0m")
    return "".join(out)


def run():
    size, rows, turning, spun, frame = None, None, speed(), 0.0, 0
    sys.stdout.write("\x1b[?1049h\x1b[?25l")  # the terminal's second screen, and no cursor
    try:
        while True:
            started = time.monotonic()
            if shutil.get_terminal_size() != size:  # the window was resized: start again
                size = shutil.get_terminal_size()
                rows = dust(size.columns, size.lines)
                sys.stdout.write("\x1b[2J")
            if frame % FPS == 0:
                turning = speed()
            frame += 1
            spun += turning / FPS  # added up frame by frame, so a change of speed is not a jump
            sys.stdout.write(picture(rows, spun))
            sys.stdout.flush()
            time.sleep(max(0, 1 / FPS - (time.monotonic() - started)))
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write("\x1b[?25h\x1b[?1049l")


def check():
    """A small hole is dark in the middle and in the corners, glows around the middle, lets the glass through, turns, and can be drawn."""
    rows = dust(40, 15)
    assert not rows[0] and not rows[-1], "the top and the bottom must be dark"
    assert all(column not in (19, 20) for column, _ in rows[7]), "the middle must be dark"
    lit = [(column, bits, top) for cells in rows for column, bits, top in glow(cells, 0) if bits]
    assert lit and all(0 < top <= 1 for _, _, top in lit), "heat outside 0 to 1"
    left = sum(bin(bits).count("1") for column, bits, _ in lit if column < 20)
    right = sum(bin(bits).count("1") for column, bits, _ in lit if column >= 20)
    assert 0.1 < (left + right) / (8 * len(lit)) < 0.7, "the dust must be dots with glass between them"
    assert left > right, "the left side must be the brighter one"
    drawn = picture(rows, 0)
    assert drawn.count("\x1b[") < 40 * 15 and any("\u2800" < character <= "\u28ff" for character in drawn), "the picture is not drawn as it should be"
    assert picture(rows, 1) != drawn, "it must turn"
    started = time.monotonic()
    big = dust(110, 30)
    for frame in range(20):
        picture(big, frame / FPS)
    print(f"ok ({(time.monotonic() - started) / 20 * 1000:.0f} ms a frame at 110 x 30; {1000 // FPS} ms is the time there is)")


if __name__ == "__main__":
    check() if sys.argv[1:] == ["check"] else run()
