# matplotlib — Sunset Ember
# Linked to ~/.matplotlib/matplotlibrc by install.sh, so every plot uses it with no code changes.
# The colours are named in theme.ini.

figure.facecolor:  {{base}}
axes.facecolor:    {{base}}
savefig.facecolor: {{base}}
figure.figsize:    8, 5
figure.dpi:        110
figure.autolayout: True

text.color:        {{text}}
axes.labelcolor:   {{text}}
axes.titlecolor:   {{text}}
xtick.color:       {{sand}}
ytick.color:       {{sand}}
axes.edgecolor:    {{faint}}

font.family:        {{font}}
font.size:          10
axes.titlesize:     12
axes.titleweight:   600
axes.titlelocation: left
axes.titlepad:      12

# ember, gold, teal, sand, olive, rose, sky
axes.prop_cycle: cycler('color', ['{{flame}}', '{{gold}}', '{{teal}}', '{{sand}}', '{{olive}}', '{{rose}}', '{{sky}}'])
lines.linewidth:   2
lines.markersize:  5

axes.grid:         True
axes.axisbelow:    True
grid.color:        {{surface}}
grid.linewidth:    1
axes.spines.top:   False
axes.spines.right: False
xtick.major.size:  0
ytick.major.size:  0

legend.frameon:    False

# No button bar under the plot.
toolbar: None
