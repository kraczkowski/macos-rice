#!/usr/bin/env python3
"""Write theme.ini into the templates under config/ and save the result under build/.

A template names a value instead of typing it:
    {{ember}}       b33219          (a template adds its own prefix: #{{ember}}, 0xff{{ember}})
    {{ember|rgb}}   179;50;25       (the form fastfetch wants)
    {{ember|float}} 0.702 0.196 0.098   (the form macOS defaults wants)
    {{font}}        any other value of theme.ini, as typed there
    {{repo}}        the folder this repo is in

~/.config links to build/, never to config/. Two things stop the run, each with the file and what
to change: a name theme.ini does not have, and a colour of the theme typed out instead of named.
"""

import configparser
import re
import shutil
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
TEMPLATES = REPO / "config"
BUILD = REPO / "build"
MANIFEST = BUILD / ".rendered"  # what the last run wrote, one path per line

NAME = re.compile(r"\{\{(\w+)(?:\|(rgb|float))?\}\}")
COLOUR = re.compile(r"[0-9a-f]{6}")
TYPED = re.compile(r"(?:#|0x[0-9a-f]{2})([0-9a-f]{6})\b", re.IGNORECASE)


def theme():
    """Every value of theme.ini by its name. The sections only group them for the reader."""
    ini = configparser.ConfigParser(inline_comment_prefixes=("#",), interpolation=None)
    try:
        ini.read(REPO / "theme.ini", encoding="utf-8")
    except configparser.DuplicateOptionError as error:
        sys.exit(f"theme.ini: '{error.option}' is there twice")
    except configparser.Error as error:
        sys.exit(f"theme.ini: {error}")
    values = {"repo": str(REPO)}
    for section in ini.sections():
        for name, value in ini[section].items():
            if name in values:
                sys.exit(f"theme.ini: '{name}' is there twice")
            # B33219 and b33219 are the same colour; the checks below know the second form.
            values[name] = value.lower() if COLOUR.fullmatch(value.lower()) else value
    return values


def rgb(colour):
    """b33219 -> 179;50;25"""
    return ";".join(str(int(colour[i : i + 2], 16)) for i in (0, 2, 4))


def floats(colour):
    """b33219 -> 0.702 0.196 0.098"""
    return " ".join(f"{int(colour[i : i + 2], 16) / 255:.3f}" for i in (0, 2, 4))


def typed(text, values):
    """The colours a template types out: any #rrggbb or 0xaarrggbb, and any colour of the theme."""
    colours = {value for value in values.values() if COLOUR.fullmatch(value)}
    lower = text.lower()
    return sorted({found.lower() for found in TYPED.findall(text)} | {c for c in colours if c in lower})


def render(text, values, file, problems):
    def value(match):
        name, form = match.groups()
        if name not in values:
            problems.append(f"{file}: names {{{{{name}}}}}, which theme.ini does not have")
        elif form and not COLOUR.fullmatch(values[name]):
            problems.append(f"{file}: {{{{{name}|{form}}}}} needs a colour, and '{values[name]}' is not one")
        else:
            return {"rgb": rgb, "float": floats, None: str}[form](values[name])
        return match.group()

    return NAME.sub(value, text)


def main():
    values = theme()
    templates = [file for file in sorted(TEMPLATES.rglob("*")) if file.is_file() and file.name != ".DS_Store" and "__pycache__" not in file.parts]
    problems, rendered = [], {}
    for file in templates:
        try:
            text = file.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            rendered[file] = None  # not text (an image, say): copied as it is
            continue
        problems += [f"{file.relative_to(REPO)}: types {colour}, name it instead" for colour in typed(text, values)]
        rendered[file] = render(text, values, file.relative_to(REPO), problems)
    if problems:
        sys.exit("\n".join(problems))
    for file, text in rendered.items():
        out = BUILD / file.relative_to(TEMPLATES)
        out.parent.mkdir(parents=True, exist_ok=True)
        if text is None:
            shutil.copyfile(file, out)
        else:
            out.write_text(text, encoding="utf-8")
        shutil.copymode(file, out)

    # A template that was deleted or renamed must not live on in build/, where its tool would
    # still load it. Only files an earlier run wrote are removed: tools keep files of their own
    # there too (btop its log).
    written = {str(file.relative_to(TEMPLATES)) for file in rendered}
    before = set(MANIFEST.read_text(encoding="utf-8").splitlines()) if MANIFEST.exists() else set()
    for gone in before - written:
        (BUILD / gone).unlink(missing_ok=True)
    MANIFEST.write_text("\n".join(sorted(written)) + "\n", encoding="utf-8")
    print(f"rendered {len(templates)} files into {BUILD}")


if __name__ == "__main__":
    main()
