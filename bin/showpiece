#!/usr/bin/env bash
# showpiece — the classic unixporn layout as three real, AeroSpace-tiled windows (alt-shift-s).
#   ┌──────────┬──────────┐
#   │ fastfetch│          │
#   ├──────────┤   btop   │
#   │   hole   │          │
#   └──────────┴──────────┘
# The one key does all of it: it opens the showpiece, goes to it when it is open and you are
# elsewhere, and from its own workspace closes it and goes back to where you were.
#
# Each pane is a Ghostty window with a title of its own ("showpiece btop"), and those titles are
# all the state there is: a pane is up exactly while a window carries its title. Only those
# windows are ever moved or closed: anything else you put on the workspace stays.
set -uo pipefail

WS=9
REPO="$(cd "$(dirname "$0")/.." && pwd)"
LOCK="${TMPDIR:-/tmp}/rice_showpiece.lock"

# The panes that are up, one a line: <window id> showpiece <name>
shown() { aerospace list-windows --all --format '%{window-id} %{window-title}' 2>/dev/null | awk '$2 == "showpiece" && NF == 3'; }
# pane <name>: the id of its window, or nothing.
pane() { shown | awk -v name="$1" '$3 == name { print $1 }'; }
all_up() { [ "$(shown | wc -l)" -eq 3 ]; }

# open_pane <name> <command...>: run the command in a new Ghostty window, unless the pane is up.
# Each pane is a Ghostty of its own (open -n), which is what lets it take settings of its own:
#   --title                         what the pane is found by; Ghostty then ignores the titles programs set
#   --confirm-close-surface=false   closing must not ask "close anyway?" about btop
#   --quit-after-last-window-closed or every closed pane would leave a windowless Ghostty in the Dock
#   --keybind ...=unbind            or every one of them would answer ctrl+` with a quick terminal
open_pane() {
  local name="$1"; shift
  [ -n "$(pane "$name")" ] && return
  open -na Ghostty.app --args --title="showpiece $name" --confirm-close-surface=false \
    --quit-after-last-window-closed=true --keybind=global:ctrl+grave_accent=unbind -e "$@"
}

# to_edge <window id> <left|right>: move the window along its row until it is the last one on that side.
to_edge() {
  for _ in 1 2 3 4 5 6 7 8; do
    aerospace move --window-id "$1" --boundaries-action fail "$2" 2>/dev/null || break
  done
}

# A press while an earlier one is still opening the windows does nothing: it would open them
# twice, or close the half that is there. A lock older than a minute was left by a run that was killed.
find "$LOCK" -maxdepth 0 -mmin +1 -exec rmdir {} \; 2>/dev/null
mkdir "$LOCK" 2>/dev/null || exit 0
trap 'rmdir "$LOCK" 2>/dev/null' EXIT

if [ -n "$(shown)" ] && [ "$(aerospace list-workspaces --focused)" = "$WS" ]; then
  for id in $(shown | cut -d' ' -f1); do
    aerospace close --window-id "$id"
  done
  aerospace workspace-back-and-forth
  exit 0
fi

aerospace workspace "$WS"
all_up && exit 0

# All three at once: a Ghostty takes about a second to start, and they need not wait for each other.
# fastfetch drops to a shell afterwards, so its output stays on screen.
open_pane fastfetch zsh -lc "cd ~/dev; fastfetch; exec zsh"
open_pane hole "$REPO/build/showpiece/hole"
open_pane btop btop
for _ in $(seq 25); do   # up to five seconds
  all_up && break
  sleep 0.2
done
all_up || exit 1

# Build the tree from scratch, whatever shape the workspace was left in and whichever window
# came first: one row with fastfetch and hole at the left end and btop at the right, then the
# left two joined into a column.
fastfetch="$(pane fastfetch)" hole="$(pane hole)" btop="$(pane btop)"
aerospace flatten-workspace-tree --workspace "$WS"
aerospace focus --window-id "$fastfetch"
aerospace layout h_tiles
to_edge "$hole" left
to_edge "$fastfetch" left         # fastfetch | hole | … | btop
to_edge "$btop" right
aerospace focus --window-id "$hole"
aerospace join-with left          # fastfetch + hole -> one container
aerospace layout v_tiles          # fastfetch above hole
aerospace focus --window-id "$fastfetch"
