#!/usr/bin/env bash
# apply-apps — hand the rendered theme to what keeps a copy of its own, where a link into build/
# is not enough: macOS its accent, the desktop its picture. Run by install.sh and bin/apply, after bin/render.
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
BUILD="$REPO/build"

"$BUILD/macos/accent"

"$REPO/bin/wallpaper" set
