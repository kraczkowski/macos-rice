#!/usr/bin/env bash
# apply-apps — hand the rendered theme to the apps that keep a copy of their own, where a link
# into build/ is not enough. Run by install.sh and bin/apply, after bin/render.
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
BUILD="$REPO/build"

"$BUILD/macos/accent"

"$REPO/bin/wallpaper" set

# VS Code copies an extension when it installs one, so the theme is installed again each time.
# A .vsix is a zip of build/vscode.
code="/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code"
if [ -x "$code" ]; then
  rm -f "$BUILD/sunset-ember.vsix"
  (cd "$BUILD/vscode" && zip -qr "$BUILD/sunset-ember.vsix" .)
  "$code" --install-extension "$BUILD/sunset-ember.vsix" --force >/dev/null
fi

# Firefox and Zen read userContent.css from their sandboxed page processes, which cannot follow a
# link out of the profile, so it is copied in. (userChrome.css is read unsandboxed: a link will do.)
user_content() {  # <firefox|zen> <its folder of profiles>
  local profile dest
  for profile in "$2"/*/; do
    [ -d "$profile" ] || continue
    dest="${profile}chrome/userContent.css"
    mkdir -p "${profile}chrome"
    [ ! -L "$dest" ] || rm "$dest"   # a link from an earlier install: cp would write through it, into build/
    cp "$BUILD/$1/userContent.css" "$dest"
  done
}
user_content firefox "$HOME/Library/Application Support/Firefox/Profiles"
user_content zen     "$HOME/Library/Application Support/zen/Profiles"
